{
  "name": "pathable",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:clean": "node scripts/clean-next.js && node scripts/dev.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx --env-file=.env.local scripts/seed-supabase.ts",
    "download-images": "node scripts/download-images.mjs",
    "check:supabase": "tsx --env-file=.env.local scripts/check-supabase.ts",
    "sync:jobs": "tsx --env-file=.env.local scripts/sync-jobs-drushim.ts",
    "sync:jobs:ci": "tsx scripts/sync-jobs-drushim.ts",
    "migrate": "tsx --env-file=.env.local scripts/apply-migration.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "next": "^14.2.35",
    "openai": "^6.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.5.2",
    "resend": "^6.12.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "pg": "^8.22.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3"
  }
}
