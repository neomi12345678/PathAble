# העתק לקובץ .env.local

# Supabase — Project Settings → API
# השתמשי ב-legacy keys (מתחילים ב-eyJ...) אם יש שגיאת Invalid API key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
# בדמו: onboarding@resend.dev (שולח רק לכתובת שפתחת איתה חשבון Resend)
# בפרודקשן: כתובת מאומתת בדומיין שלך, למשל onboarding@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Setup:
# 1. Run supabase/migrations/001_initial.sql in Supabase SQL Editor
# 2. Fill keys above
# 3. npm run seed
#
# Google OAuth (Supabase Dashboard):
# - Authentication → Providers → Google → enable + Client ID/Secret
# - Authentication → URL Configuration:
#   Site URL: http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback
